{
  "name": "durable-channel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "mac:build": "mkdir -p .build && swiftc scripts/decode-message.swift -o .build/decode-message",
    "mac:bridge": "node --env-file-if-exists=.env.mac src/mac-main.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  }
}
