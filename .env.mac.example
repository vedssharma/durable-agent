# Copy to .env.mac on the signed-in Mac (not the Linux agent).
MAC_AGENT_WEBHOOK_URL=https://agent.example.com/webhooks/imessage
# Match the server's IMESSAGE_WEBHOOK_TOKEN and IMESSAGE_BRIDGE_TOKEN respectively.
# Generate TWO DIFFERENT secrets with openssl rand -hex 32.
MAC_WEBHOOK_TOKEN=
MAC_BRIDGE_TOKEN=
# Exact incoming handles, e.g. +15551234567,person@example.com. Match server allowlist.
MAC_ALLOWED_SENDERS=
MAC_PORT=3040
MAC_DATA_DIR=./mac-data
# Optional database override; defaults to ~/Library/Messages/chat.db.
# MAC_MESSAGES_DB=
