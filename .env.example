# Copy to .env; keep secrets out of git. Empty channels are disabled.
OPENAI_API_KEY=
MODEL_ID=gpt-6.1-sol
DATA_DIR=./data
HOST=127.0.0.1
PORT=3000

# Telegram: set all three to enable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_SENDERS=
# polling works locally without public HTTPS; empty defaults to webhook.
TELEGRAM_MODE=

# Slack: set all four to enable. IDs, not display names.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_ALLOWED_SENDERS=

# WhatsApp Business Cloud API: set all six to enable.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set a supported version from your Meta app, e.g. vXX.X (not the literal placeholder).
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ALLOWED_SENDERS=

# Optional included Mac bridge: see docs/mac-bridge.md and .env.mac.example.
# HTTPS /send endpoint on your signed-in Mac, not a Linux iMessage implementation.
IMESSAGE_BRIDGE_URL=
IMESSAGE_BRIDGE_TOKEN=
IMESSAGE_WEBHOOK_TOKEN=
IMESSAGE_ALLOWED_SENDERS=
